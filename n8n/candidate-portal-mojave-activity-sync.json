    {
      "parameters": {
        "jsCode": "const EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nfunction text(value) {\n  return String(value ?? '').trim();\n}\n\nfunction read(row, ...names) {\n  const keys = Object.keys(row || {});\n  for (const name of names) {\n    const key = keys.find((candidate) => candidate.trim().toLowerCase() === name.toLowerCase());\n    if (key && row[key] !== null && row[key] !== undefined) return row[key];\n  }\n  return '';\n}\n\nfunction count(value) {\n  const parsed = Number(text(value).replace(/[,\\s]/g, ''));\n  return Number.isFinite(parsed) ? Math.max(0, Math.trunc(parsed)) : 0;\n}\n\nconst asOf = new Date().toISOString().slice(0, 10);\nconst output = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const email = text(read(row, 'CONTRIBUTOR EMAIL', 'Email')).toLowerCase();\n  const activityStatus = text(read(row, 'ACTIVITY STATUS', 'Status')).toLowerCase();\n  if (!EMAIL_RE.test(email) || activityStatus !== 'active') continue;\n\n  output.push({\n    json: {\n      p_email: email,\n      p_domain: text(read(row, 'DOMAIN')) || null,\n      p_as_of: asOf,\n      p_submitted: count(read(row, 'TOTAL SUBMISSIONS')),\n      p_accepted: count(read(row, 'TOTAL ACCEPTED')),\n      p_rejected: count(read(row, 'TOTAL REJECTED')),\n      p_rework: count(read(row, 'TOTAL NEEDS REVISION')),\n      p_source_sheet: 'SnorkelxMojave - Sub Contracting Payment / Client Shared Details - till 31st July',\n    },\n  });\n}\n\nreturn output;"
      },
